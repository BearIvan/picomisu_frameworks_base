// Factory PICO OS 5.13.7 libraries that the factory system libraries link directly
// (DT_NEEDED) and that Source carries as binaries: they have no published source.
//
// factory/lib*/ are links to the verified factory system tree of this project
// (analysis/stock-5.13.7-system/root/system/lib*/, the files the Source image carries), so
// the build installs exactly the factory binaries (no strip, SHA-256 below) and Source links
// them like the factory does instead of binding them with dlopen()/dlsym():
//   lib/libsysperftracker.so       409254ca297f9ab1adcc0b99d9f2c98f494bdfaec5ec8b802038846016be4678
//   lib64/libsysperftracker.so     8c766a8f83ff0ae3a82cbb85b6a5c2e54ed3b5cc480e532f5fa6f07ce6071ec0
//   lib64/libaudioeventtracking.so e103ff7447776a985f69ea71f54a58eeebc9dc0c6032ab894c8ea4e6af676c6b
//   lib/libpxrmediametrics.so      a9f0471ae715e92e3c2b72bf081022169f2e3612e9ae9ac7af8bca02c467df8b
//   lib64/libpxrmediametrics.so    70e6ccec65b52d3d293d117007a5bb47e5a54ec6edf6a4a64e9151da909dcd42
// The headers declare only the exported members Source calls, by their factory mangled names.
// The libraries' own dependencies (libswitchstate, libsysmtpdata, libjsoncpp, ...) are on the
// image already; check_elf_files is off as for the other factory prebuilts.

// mtp::SysMtpClient, the PICO system monitor client (libhwui, libsurfaceflinger).
cc_prebuilt_library_shared {
    name: "libsysperftracker",
    export_include_dirs: ["sysperftracker/include"],
    arch: {
        arm: {
            srcs: ["factory/lib/libsysperftracker.so"],
        },
        arm64: {
            srcs: ["factory/lib64/libsysperftracker.so"],
        },
    },
    check_elf_files: false,
    strip: {
        none: true,
    },
}

// android::pico::audioeventtracking::AudioEventTracker (audio server). The factory has only
// the 64-bit library; the header also serves the 32-bit builds of the audio libraries.
cc_library_headers {
    name: "libaudioeventtracking_headers",
    export_include_dirs: ["audioeventtracking/include"],
    header_libs: ["libaudio_system_headers"],
    export_header_lib_headers: ["libaudio_system_headers"],
}

cc_prebuilt_library_shared {
    name: "libaudioeventtracking",
    compile_multilib: "64",
    srcs: ["factory/lib64/libaudioeventtracking.so"],
    check_elf_files: false,
    strip: {
        none: true,
    },
}

// android::pico::PxrMediaAnalyticsItem, PICO media metrics (libstagefright).
cc_prebuilt_library_shared {
    name: "libpxrmediametrics",
    export_include_dirs: ["pxrmediametrics/include"],
    arch: {
        arm: {
            srcs: ["factory/lib/libpxrmediametrics.so"],
        },
        arm64: {
            srcs: ["factory/lib64/libpxrmediametrics.so"],
        },
    },
    check_elf_files: false,
    strip: {
        none: true,
    },
}
